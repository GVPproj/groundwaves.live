---
import { PortableText } from "astro-portabletext";
import { safeFetch } from "../../lib/sanity";
import AfwWordmark from "./AfwWordmark.astro";
import { MAILING_LIST } from "../../lib/links";

const AFW = "https://afriendlywave.com";
const GVP = "https://grahamvanpelt.dev";

// The about copy lives here now — there is no /about page, the nav scrolls to
// this footer instead.
const { aboutText } = await safeFetch(
  `*[_type == "aboutContent"]{aboutText}[0]`,
  {} as { aboutText?: any },
);

// The last paragraph of aboutContent is the land acknowledgement, which gets
// its own fine-print treatment. Split by position — if it ever needs to be
// explicit, it should become its own field on the aboutContent schema.
const blocks: any[] = aboutText ?? [];
const prose = blocks.length > 1 ? blocks.slice(0, -1) : blocks;
const landAck = blocks.length > 1 ? blocks[blocks.length - 1] : null;

const year = new Date().getFullYear();
---

<!-- .site-footer: hook for the focus-ring rule in base.css -->
<footer
  id="about"
  class="site-footer mt-auto w-full scroll-mt-24 bg-skin-base text-skin-fill"
>
  <div class="max-w-screen-xl mx-auto px-6 md:px-10 py-20 md:py-24">
    <div class="grid grid-cols-1 md:grid-cols-[1.15fr_1fr] gap-x-16 gap-y-14">
      <div>
        {
          prose.length > 0 && (
            <>
              <h2 class="font-mono text-[0.7rem] uppercase tracking-[0.3em] mb-6 text-skin-accent-inverted">
                About
              </h2>
              <div class="text-[1.05rem] leading-[1.65] [&_p]:mb-5 [&_p:last-child]:mb-0">
                <PortableText value={prose} />
              </div>
            </>
          )
        }
        {
          landAck && (
            <div class="mt-8 pl-5 border-l border-skin-accent-inverted/60 text-base italic leading-[1.7] [&_p]:mb-0">
              <PortableText value={[landAck]} />
            </div>
          )
        }
      </div>

      <!-- links read as a directory: hairline rows you scan, not inline text -->
      <div class="md:pl-16 md:border-l md:border-skin-fill/20">
        <h2
          class="font-mono text-[0.7rem] uppercase tracking-[0.3em] mb-6 text-skin-accent-inverted"
        >
          Groundwaves
        </h2>
        <ul class="list-none p-0 m-0">
          <li class="border-t border-skin-fill/15 last:border-b">
            <a class="group flex items-center justify-between gap-4 py-[0.85rem] text-[1.05rem]
              text-skin-fill no-underline transition-colors
              hover:text-skin-accent-inverted motion-reduce:transition-none" href="/#events">
              <span>events</span><span
                class="font-mono opacity-50 transition
                group-hover:opacity-100 group-hover:translate-x-[3px]
                motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
                aria-hidden="true">&rarr;</span
              >
            </a>
          </li>
          <li class="border-t border-skin-fill/15 last:border-b">
            <a class="group flex items-center justify-between gap-4 py-[0.85rem] text-[1.05rem]
              text-skin-fill no-underline transition-colors
              hover:text-skin-accent-inverted motion-reduce:transition-none" href={MAILING_LIST}>
              <span>join the mailing list</span><span
                class="font-mono opacity-50 transition
                group-hover:opacity-100 group-hover:translate-x-[3px]
                motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
                aria-hidden="true">&#8599;</span
              >
            </a>
          </li>
        </ul>

        <a
          class="mt-12 inline-flex no-underline transition-opacity
            hover:opacity-70 motion-reduce:transition-none"
          href={AFW}
          target="_blank"
          rel="noopener noreferrer"
        >
          <AfwWordmark class="h-9 md:h-11" />
        </a>
      </div>
    </div>

    <!-- font-light, not font-thin: 300 is the lightest Fraunces face we ship,
         so anything lighter silently resolves back up to it anyway. -->
    <div class="border-t border-skin-fill/20 mt-32 pt-6 text-xs font-light">
      <p class="mb-0">&copy; {year} Groundworks</p>
      <p class="mb-0">
        Website: <a
          class="italic text-sm text-skin-accent-inverted hover:text-skin-accent-inverted"
          href={GVP}
          target="_blank"
          rel="noopener noreferrer">grahamvanpelt.dev</a
        >
      </p>
    </div>
  </div>
</footer>

