---
import AstroDropdown from "./AstroDropdown.astro";
import AfwWordmark from "./AfwWordmark.astro";
---

<header
  id="site-header"
  class="fixed z-40 w-full bg-opacity-30 shadow backdrop-blur transition-transform duration-300"
>
  <div
    class="flex items-center md:items-baseline justify-between gap-12 px-8 max-w-screen-xl mx-auto my-4"
  >
    <a
      class="text-3xl md:text-4xl font-bold pb-2 md:pb-0 no-underline"
      href="/"
      data-astro-reload
    >
      groundwaves
    </a>
    <div id="desktop" class="hidden md:flex items-center gap-6 w-full">
      <!-- items-baseline: wordmark is a tight-cropped SVG whose bottom edge ==
           its letter baseline, so aligning baselines drops it onto the same line
           as the events/about links and removes the centered top/bottom gap that
           a tiny h-4 wordmark picked up under items-center. -->
      <nav
        aria-label="Primary"
        class="flex-initial md:flex-1 flex items-baseline gap-6"
      >
        <a
          class="flex items-center shrink-0"
          href="https://afriendlywave.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          <AfwWordmark class="h-[1.375rem] translate-y-[19%]" />
        </a>
        <a href="/#events">events</a>
        <a href="/#about">about</a>
      </nav>
      <a href="https://rkbce3s6n3o.typeform.com/to/FMhtniXO">
        <button
          type="button"
          class="cta-button font-bold ml-auto"
          onclick="location.href='https://rkbce3s6n3o.typeform.com/to/FMhtniXO';"
          value="Join Mailing List"
        >
          Join
        </button>
      </a>
    </div>
    <AstroDropdown />
  </div>
</header>

<style>
  .hide-on-scroll {
    transform: translateY(-100%);
  }
</style>

<script is:inline>
  let lastScrollY = window.scrollY;
  let ticking = false;
  const header = document.getElementById("site-header");

  function onScroll() {
    if (!header) return;
    const currentScrollY = window.scrollY;
    if (currentScrollY > lastScrollY && currentScrollY > 10) {
      // Scrolling down
      header.classList.add("hide-on-scroll");
    } else {
      // Scrolling up
      header.classList.remove("hide-on-scroll");
    }
    lastScrollY = currentScrollY;
    ticking = false;
  }

  function requestTick() {
    if (!ticking) {
      requestAnimationFrame(onScroll);
      ticking = true;
    }
  }

  window.addEventListener("scroll", requestTick);
</script>
