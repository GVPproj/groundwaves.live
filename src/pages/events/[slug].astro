---
import { safeFetch } from "../../lib/sanity";
import { PortableText } from "astro-portabletext";
import { YouTube } from "astro-embed";
import Layout from "../../layouts/Layout.astro";
import SanityImage from "../../components/fragments/SanityImage.astro";
import type { Event, Venue, Artist } from "../../sanity.types";

// Event type with expanded references (from GROQ queries with ->)
type EventWithRefs = Event & {
  slug: string;
  venue?: Venue;
  headline?: Artist;
};

export async function getStaticPaths() {
  const events = await safeFetch<EventWithRefs[]>(
    `*[_type == "event" && defined(slug.current)]{
      "slug": slug.current,
      _id,
      name,
      date,
      endDate,
      eventCopy,
      image,
      youtubeEmbeds,
      tickets,
      headline->,
      venue->
    }`,
    [],
  );

  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const isPastEvent = new Date(event.date) < new Date();

const fmtDate = (d?: string) =>
  d
    ? new Date(d).toLocaleDateString("en-US", {
        timeZone: "America/Los_Angeles",
        year: "numeric",
        month: "long",
        day: "numeric",
      })
    : "";

// One meta line — date (or range) and venue — in the same mono treatment the
// homepage cards use for the same facts, so the card and the page it links to
// read as the same design.
// Several events carry an endDate on the same day as the start; showing the
// range verbatim would print the same date twice.
const start = fmtDate(event.date);
const end = fmtDate(event.endDate);
const dateRange = end && end !== start ? `${start} – ${end}` : start;
const meta = [dateRange, event.venue?.name].filter(Boolean).join(" · ");
---

<Layout title={event.name}>
  <main id="main" tabindex="-1">
    <section
      class="flex text-center flex-col mx-auto items-center pb-16 max-w-prose w-[100%]"
    >
      <!-- min-w-0: as a flex item this defaults to min-width:auto, so it can't
           shrink below its min-content width. One event's copy links raw URLs
           as their own link text, which set a ~370px floor and pushed the whole
           column past a 320px viewport. -->
      <div class="items-center my-6 min-w-0 w-full">
        {
          !isPastEvent && event.tickets ? (
            <a href={event.tickets} class="no-underline">
              <SanityImage
                node={event.image}
                width="800"
                classNames="mx-auto mb-16"
              />
            </a>
          ) : (
            <SanityImage
              node={event.image}
              width="800"
              classNames="mx-auto mb-16"
            />
          )
        }
        {
          !isPastEvent && event?.tickets && (
            <a href={event.tickets} class="cta-button mb-16">
              Get Tickets
            </a>
          )
        }
        <p class="ev-meta font-mono text-[0.7rem] uppercase tracking-[0.3em] mb-4">
          {meta}
        </p>
        <h1
          class="font-bold leading-[1.05] tracking-[-0.01em] text-[clamp(1.75rem,5vw,3rem)] mb-12"
        >
          {event.name}
        </h1>
        <div class="ev-copy text-left prose prose-base">
          <PortableText value={event.eventCopy} />
        </div>
        {
          event.youtubeEmbeds &&
            event.youtubeEmbeds.map((emb: string) => {
              if (typeof emb !== "string") {
                console.warn(`Invalid YouTube ID: ${emb}`);
                return null;
              }
              // youtubeEmbeds is a flat array of ID strings with no per-video
              // title to pass, so the event name is the best label available —
              // it beats astro-embed's default bare "Play".
              return (
                <YouTube
                  class="w-full mx-auto mt-8"
                  id={emb}
                  playlabel={`Play: ${event.name}`}
                />
              );
            })
        }
        {
          !isPastEvent && event?.tickets && (
            <a href={event.tickets} class="cta-button mt-16">
              Get Tickets
            </a>
          )
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  /* the accent green rather than the homepage's bright/orange variants — this
     page sits on the light ground, not the dark hero */
  .ev-meta {
    color: hsl(var(--color-accent));
  }

  /* This carried `prose-base` without `prose`, so the typography plugin never
     applied — prose-base is only a size modifier and emits font-size/margin
     alone. With `prose` on, the plugin's own greys would override the site
     palette, so point its variables back at our tokens. */
  .ev-copy {
    --tw-prose-body: hsl(var(--color-text-base));
    --tw-prose-headings: hsl(var(--color-text-base));
    --tw-prose-lead: hsl(var(--color-text-base));
    --tw-prose-bold: hsl(var(--color-text-base));
    --tw-prose-quotes: hsl(var(--color-text-base));
    --tw-prose-captions: hsl(var(--color-text-base));
    --tw-prose-code: hsl(var(--color-text-base));
    --tw-prose-links: hsl(var(--color-accent));
    --tw-prose-counters: hsl(var(--color-text-base));
    --tw-prose-bullets: hsl(var(--color-accent));
    --tw-prose-hr: hsla(var(--color-text-base), 0.2);
    --tw-prose-quote-borders: hsla(var(--color-accent), 0.4);
    --tw-prose-th-borders: hsla(var(--color-text-base), 0.3);
    --tw-prose-td-borders: hsla(var(--color-text-base), 0.15);

    /* pairs with min-w-0 above: once the column can shrink, the raw-URL link
       text still needs permission to break rather than spill out of it */
    overflow-wrap: break-word;
  }
  /* no .ev-copy a:hover rule here on purpose: the typography plugin writes its
     link colour through zero-specificity :where(), so the base `a:hover` in
     base.css already wins and supplies the light-ground orange. Verified in
     Chromium. */
</style>
