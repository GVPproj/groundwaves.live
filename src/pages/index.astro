---
import Layout from "../layouts/Layout.astro";
import { safeFetch } from "../lib/sanity";
import { MAILING_LIST } from "../lib/links";
import { PortableText } from "astro-portabletext";
import SanityImage from "../components/fragments/SanityImage.astro";
import type { Event, Venue } from "../../sanity.types";

// The base Event type has venue/slug as reference objects; our GROQ queries
// dereference them with -> so this is what we actually get at runtime.
type EventWithRefs = Omit<Event, "venue" | "slug"> & {
  slug?: { current: string };
  venue?: Venue;
};

const { headline, heroText, imageGallery } = await safeFetch(
  `*[_type == "indexContent"]{headline, heroText, imageGallery}[0]`,
  {} as { headline?: any; heroText?: any; imageGallery?: any },
);

const upcomingEvents = await safeFetch<EventWithRefs[]>(
  `*[_type == "event" && date > now()]{_id, name, slug, date, endDate, image, tickets, venue->}|order(date asc)`,
  [],
);
const pastEvents = await safeFetch<EventWithRefs[]>(
  `*[_type == "event" && date < now()]{_id, name, slug, date, endDate, image, venue->}|order(date desc)`,
  [],
);

const gallery = imageGallery ?? [];
const next = upcomingEvents[0];

// Hero crossfade: every gallery image is stacked and runs the same keyframes,
// offset by one cycle each. HOLD is the still time, FADE the overlap where the
// outgoing and incoming image are both partly visible.
//
// KNOWN GAP (WCAG 2.2.2): this auto-plays with no pause control. Accepted
// because the images are decorative, sit behind a heavy scrim, and fade
// without movement; `prefers-reduced-motion` (below) stops it outright.
// Revisit if the gallery ever carries meaning or the transition gains motion.
const slides = gallery.slice(0, 6);
const HOLD = 5;
const FADE = 1.75;
const CYCLE = HOLD + FADE;
const TOTAL = slides.length * CYCLE;
const pct = (t: number) => `${((t / TOTAL) * 100).toFixed(3)}%`;

// The homepage grid is the events listing now — there is no /events index —
// so every event lands here rather than a slice of them.
const eventHref = (event: EventWithRefs, upcoming: boolean) =>
  upcoming && event.tickets
    ? event.tickets
    : `/events/${event.slug?.current ?? ""}`;

const eventGroups = [
  { title: "Upcoming", events: upcomingEvents, upcoming: true },
  { title: "Past Events", events: pastEvents, upcoming: false },
].filter((bucket) => bucket.events.length > 0);

// The last word of the headline gets the accent colour ("...Our Nature").
const splitHeadline = (text?: string) => {
  const match = text?.match(/^(.*\s)(\S+)$/);
  return match ? { lead: match[1], last: match[2] } : null;
};
const headlineParts = splitHeadline(headline);

const fmtDate = (d?: string) =>
  d
    ? new Date(d).toLocaleDateString("en-US", {
        timeZone: "America/Los_Angeles",
        month: "short",
        day: "numeric",
        year: "numeric",
      })
    : "";
---

<Layout title="groundwaves">
  <!-- .home-inverted: hook the global block at the foot of this file uses to
       theme the fixed site header -->
  <main
    id="main"
    tabindex="-1"
    class="home-inverted bg-skin-accent-deep text-skin-fill"
  >
    <!-- full-bleed hero -->
    <section
      class="relative flex min-h-[100svh] flex-col justify-start overflow-hidden"
    >
      <div class="home-slides absolute inset-0 opacity-70">
        {
          slides.map((node: any, i: number) => (
            <div
              class:list={[
                "absolute inset-0",
                slides.length > 1 && "home-slide",
              ]}
              style={`animation-delay:${(i * CYCLE - FADE).toFixed(2)}s`}
            >
              <SanityImage
                node={node}
                width="2000"
                classNames="w-full h-full object-cover"
              />
            </div>
          ))
        }
      </div>
      <div class="home-scrim absolute inset-0"></div>

      <div
        class="relative max-w-screen-xl mx-auto w-full px-6 md:px-10 pb-16 pt-40 md:pt-52"
      >
        <p
          class="font-mono text-[0.85rem] md:text-sm uppercase tracking-[0.3em] mb-6 pl-2 text-skin-accent-inverted"
        >
          {
            next
              ? `${fmtDate(next.date)} · ${next.venue?.name ?? "Salt Spring Island"}`
              : "Salt Spring Island, BC"
          }
        </p>
        <h1
          class="font-bold leading-[0.95] tracking-[-0.01em] text-[clamp(2.25rem,8vw,6rem)] max-w-[16ch] mb-8"
        >
          {
            next?.name ??
              (headlineParts ? (
                <>
                  {headlineParts.lead}
                  <span class="text-skin-accent-inverted">
                    {headlineParts.last}
                  </span>
                </>
              ) : (
                (headline ?? "groundwaves")
              ))
          }
        </h1>
        {
          headline && next && (
            <p class="text-xl md:text-2xl max-w-2xl mb-10">
              {headlineParts ? (
                <>
                  {headlineParts.lead}
                  <span class="text-skin-accent-inverted">
                    {headlineParts.last}
                  </span>
                </>
              ) : (
                headline
              )}
            </p>
          )
        }
        <div class="flex flex-wrap items-center gap-4">
          <a href={next?.tickets ?? "#events"} class="cta-button font-bold">
            {next?.tickets ? "Tickets" : "events"}
          </a>
          <a
            href={MAILING_LIST}
            class="cta-button font-bold"
            aria-label="Join Mailing List"
          >
            Join
          </a>
        </div>
      </div>
    </section>

    <!-- statement -->
    {
      heroText && (
        <section class="max-w-screen-md mx-auto px-6 md:px-10 py-24 md:py-32 text-center">
          <div class="text-2xl md:text-[2rem] leading-snug [&_p]:mb-6 [&_a]:text-skin-accent-bright [&_a:hover]:text-skin-accent-inverted">
            <PortableText value={heroText} />
          </div>
        </section>
      )
    }

    <!-- events: the full listing lives here, the nav scrolls to it -->
    <div id="events" class="scroll-mt-24 md:scroll-mt-28">
      {
        eventGroups.map((bucket) => (
          <section class="max-w-screen-xl mx-auto px-6 md:px-10 pb-24">
            <div class="border-b border-skin-fill/25 pb-4 mb-10">
              <h2 class="font-mono text-[0.7rem] uppercase tracking-[0.3em] text-skin-accent-inverted">
                {bucket.title}
              </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 items-start gap-x-6 gap-y-14">
              {bucket.events.map((event) => (
                <a
                  href={eventHref(event, bucket.upcoming)}
                  class="group block no-underline text-skin-fill hover:text-skin-accent-inverted"
                >
                  <SanityImage
                    node={event.image}
                    width="800"
                    classNames="w-full h-auto mb-5 transition-opacity group-hover:opacity-80"
                  />
                  <p class="font-mono text-[0.7rem] uppercase tracking-[0.3em] mb-2 text-skin-accent-bright">
                    {fmtDate(event.date)}
                  </p>
                  <h3 class="text-2xl font-bold leading-tight mb-1">
                    {event.name}
                  </h3>
                  <p class="text-sm opacity-60">{event.venue?.name}</p>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <!-- closing band. .home-band: hook for the focus-ring rule in base.css -->
    <div class="home-band bg-skin-fill text-skin-base">
      <div
        class="max-w-screen-xl mx-auto px-6 md:px-10 py-20 md:py-28 text-center"
      >
        <h2
          class="font-bold leading-[0.95] text-[clamp(1.75rem,5vw,3.5rem)] mb-8"
        >
          Don't miss<br />the next one!
        </h2>
        <a
          href={MAILING_LIST}
          class="cta-button cta-button-lg font-bold"
          aria-label="Join Mailing List"
        >
          Join
        </a>
      </div>
    </div>
  </main>
</Layout>

{
  slides.length > 1 && (
    <>
      <style
        is:inline
        set:html={`
      .home-slides.is-ready .home-slide {
        animation: home-crossfade ${TOTAL}s linear infinite both;
      }
      @keyframes home-crossfade {
        0%, 100% { opacity: 0 }
        ${pct(FADE)}, ${pct(CYCLE)} { opacity: 1 }
        ${pct(CYCLE + FADE)} { opacity: 0 }
      }
      @media (prefers-reduced-motion: reduce) {
        .home-slides.is-ready .home-slide { animation: none }
      }
    `}
      />
      <script
        is:inline
        set:html={`
      (() => {
        const slides = document.querySelector(".home-slides");
        if (!slides) return;
        const img = slides.querySelector("img");
        const start = () => slides.classList.add("is-ready");
        if (!img || img.complete) start();
        else {
          img.addEventListener("load", start, { once: true });
          img.addEventListener("error", start, { once: true });
        }
      })();
      `}
      />
    </>
  )
}

<!-- the site header is fixed and light by default; invert it over this page -->
<style is:global>
  body:has(.home-inverted) {
    background: hsl(var(--color-accent-deep));
  }
  body:has(.home-inverted) #site-header {
    background: transparent;
    box-shadow: none;
  }
  body:has(.home-inverted) #site-header a {
    color: hsl(var(--color-fill));
  }
  body:has(.home-inverted) #site-header a:hover {
    color: hsl(var(--color-accent-inverted));
  }
  body:has(.home-inverted) #site-header .cta-button:hover {
    color: hsl(var(--color-text-base));
  }
  body:has(.home-inverted) #site-header svg {
    fill: hsl(var(--color-fill));
  }
  body:has(.home-inverted) #site-header a:hover svg {
    fill: hsl(var(--color-accent-inverted));
  }
  /* the hamburger is a stroked icon (stroke="currentColor"), so the fill rules
     above don't touch it — it needs `color` to read on the dark hero */
  body:has(.home-inverted) #site-header #dropdown-toggle {
    color: hsl(var(--color-fill));
  }
  body:has(.home-inverted) #site-header #dropdown-toggle:hover {
    color: hsl(var(--color-accent-inverted));
  }
  /* the open mobile menu is a light full-screen panel inside the header —
     the inversion above would render it white-on-white, so restore the
     default palette here */
  body:has(.home-inverted) #dropdown-content a:not(.cta-button) {
    color: hsl(var(--color-accent));
  }
  /* the deep orange, not the bright one: this panel is a light ground, where
     the bright orange is 2.19:1 */
  body:has(.home-inverted) #dropdown-content a:not(.cta-button):hover {
    color: hsl(var(--color-accent-inverted-deep));
  }
  body:has(.home-inverted) #dropdown-content a:not(.cta-button) svg {
    fill: hsl(var(--color-accent-inverted));
  }
  body:has(.home-inverted) #dropdown-content a:not(.cta-button):hover svg {
    fill: hsl(var(--color-accent));
  }
</style>

<style>
  /* The 35% stop is where the hero copy sits, so it sets the worst-case
     contrast: 0.62 puts the near-white h1 at 4.88:1 over a blown-out photo
     while the image stays clearly readable. The 78% and 100% stops exist to
     keep the ramp monotonic, so it never dips lighter below the text.
     The sub-paragraph under the h1 renders at full opacity for the same
     reason — at text-xl (20px, non-bold) it needs 4.5:1.
     KNOWN GAP (WCAG 1.4.3): the hero's meta line and its headline accent span
     are text-skin-accent-inverted, and orange cannot pass 4.5:1 over an
     arbitrary photo at any usable scrim — it needs the image ~96% covered.
     Accepted deliberately to keep the hero's accent colour; revisit by
     recolouring those two to text-skin-fill if the gap ever needs closing. */
  .home-scrim {
    background: linear-gradient(
      to bottom,
      hsla(var(--color-accent-deep), 0.85) 0%,
      hsla(var(--color-accent-deep), 0.62) 35%,
      hsla(var(--color-accent-deep), 0.7) 78%,
      hsla(var(--color-accent-deep), 0.85) 100%
    );
  }
  /* Each slide runs the full cycle offset by its index, so the tail of one
     fade-out overlaps the head of the next fade-in. `both` fill keeps a slide
     hidden through its start delay. The first slide is shown on paint; the
     animation only starts (via .is-ready) once its image has loaded, and its
     negative delay places it mid-hold so it never fades in from nothing. */
  .home-slide {
    opacity: 0;
  }
  .home-slide:first-child {
    opacity: 1;
  }
</style>
