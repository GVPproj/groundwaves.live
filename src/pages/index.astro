---
import Layout from "../layouts/Layout.astro";
import { safeFetch } from "../lib/sanity";
import { PortableText } from "astro-portabletext";
import SanityImage from "../components/fragments/SanityImage.astro";
import type { Event, Venue } from "../../sanity.types";

// The base Event type has venue/slug as reference objects; our GROQ queries
// dereference them with -> so this is what we actually get at runtime.
type EventWithRefs = Omit<Event, "venue" | "slug"> & {
  slug?: { current: string };
  venue?: Venue;
};

const MAILING_LIST = "https://rkbce3s6n3o.typeform.com/to/FMhtniXO";

const { headline, heroText, imageGallery } = await safeFetch(
  `*[_type == "indexContent"]{headline, heroText, imageGallery}[0]`,
  {} as { headline?: any; heroText?: any; imageGallery?: any },
);

const upcomingEvents = await safeFetch<EventWithRefs[]>(
  `*[_type == "event" && date > now()]{_id, name, slug, date, endDate, image, tickets, venue->}|order(date asc)`,
  [],
);
const pastEvents = await safeFetch<EventWithRefs[]>(
  `*[_type == "event" && date < now()]{_id, name, slug, date, endDate, image, venue->}|order(date desc)`,
  [],
);

const gallery = imageGallery ?? [];
const next = upcomingEvents[0];

// Hero crossfade: every gallery image is stacked and runs the same keyframes,
// offset by one cycle each. HOLD is the still time, FADE the overlap where the
// outgoing and incoming image are both partly visible.
const slides = gallery.slice(0, 6);
const HOLD = 5;
const FADE = 1.75;
const CYCLE = HOLD + FADE;
const TOTAL = slides.length * CYCLE;
const pct = (t: number) => `${((t / TOTAL) * 100).toFixed(3)}%`;

// The homepage grid is the events listing now — there is no /events index —
// so every event lands here rather than a slice of them.
const eventHref = (event: EventWithRefs, upcoming: boolean) =>
  upcoming && event.tickets
    ? event.tickets
    : `/events/${event.slug?.current ?? ""}`;

const eventGroups = [
  { title: "Upcoming", events: upcomingEvents, upcoming: true },
  { title: "Past Events", events: pastEvents, upcoming: false },
].filter((bucket) => bucket.events.length > 0);

const fmtDate = (d?: string) =>
  d
    ? new Date(d).toLocaleDateString("en-US", {
        timeZone: "America/Los_Angeles",
        month: "short",
        day: "numeric",
        year: "numeric",
      })
    : "";
---

<Layout title="groundwaves">
  <main class="home-inverted !mt-0 text-skin-fill">
    <!-- full-bleed hero -->
    <section
      class="!flex relative !max-w-none !px-0 !mx-auto min-h-[100svh] flex-col justify-start overflow-hidden"
    >
      <div class="home-slides absolute inset-0 opacity-70">
        {
          slides.map((node: any, i: number) => (
            <div
              class:list={[
                "absolute inset-0",
                slides.length > 1 && "home-slide",
              ]}
              style={`animation-delay:${(i * CYCLE).toFixed(2)}s`}
            >
              <SanityImage
                node={node}
                width="2000"
                classNames="w-full h-full object-cover"
              />
            </div>
          ))
        }
      </div>
      <div class="home-scrim absolute inset-0"></div>

      <div
        class="relative max-w-screen-xl mx-auto w-full px-6 md:px-10 pb-16 pt-40 md:pt-52"
      >
        <p
          class="home-meta home-meta-hero text-[0.85rem] md:text-sm uppercase tracking-[0.35em] mb-6 pl-2"
        >
          {
            next
              ? `${fmtDate(next.date)} · ${next.venue?.name ?? "Salt Spring Island"}`
              : "Salt Spring Island, BC"
          }
        </p>
        <h1
          class="font-bold leading-[0.95] tracking-[-0.01em] text-[clamp(2.25rem,8vw,6rem)] max-w-[16ch] mb-8"
        >
          {next?.name ?? headline ?? "groundwaves"}
        </h1>
        {
          headline && next && (
            <p class="text-xl md:text-2xl max-w-2xl mb-10 opacity-80">
              {headline}
            </p>
          )
        }
        <div class="flex flex-wrap items-center gap-4">
          <a href={next?.tickets ?? "#events"} class="no-underline">
            <button type="button" class="cta-button font-bold">
              {next?.tickets ? "Tickets" : "events"}
            </button>
          </a>
          <a href={MAILING_LIST} class="no-underline">
            <button type="button" class="cta-button font-bold"> Join </button>
          </a>
        </div>
      </div>
    </section>

    <!-- statement -->
    {
      heroText && (
        <section class="!block max-w-screen-md !mx-auto !px-6 md:!px-10 py-24 md:py-32 text-center">
          <div class="home-statement text-2xl md:text-[2rem] leading-snug [&_p]:mb-6">
            <PortableText value={heroText} />
          </div>
        </section>
      )
    }

    <!-- events: the full listing lives here, the nav scrolls to it -->
    <div id="events" class="scroll-mt-24 md:scroll-mt-28">
      {
        eventGroups.map((bucket) => (
          <section class="!block max-w-screen-xl !mx-auto !px-6 md:!px-10 pb-24">
            <div class="home-rule border-b pb-4 mb-10">
              <h2 class="uppercase tracking-[0.2em] text-sm font-semibold">
                {bucket.title}
              </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 items-start gap-x-6 gap-y-14">
              {bucket.events.map((event) => (
                <a
                  href={eventHref(event, bucket.upcoming)}
                  class="group block no-underline text-skin-fill"
                >
                  <SanityImage
                    node={event.image}
                    width="800"
                    classNames="w-full h-auto mb-5 transition-opacity group-hover:opacity-80"
                  />
                  <p class="home-meta text-[0.7rem] uppercase tracking-[0.2em] mb-2">
                    {fmtDate(event.date)}
                  </p>
                  <h3 class="text-2xl font-semibold leading-tight mb-1">
                    {event.name}
                  </h3>
                  <p class="text-sm opacity-60">{event.venue?.name}</p>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <!-- closing band -->
    <div class="home-band text-skin-base">
      <div class="max-w-screen-xl mx-auto px-6 md:px-10 py-20 text-center">
        <h2
          class="font-bold leading-[0.95] text-[clamp(1.75rem,5vw,3.5rem)] mb-8"
        >
          Don't miss<br />the next one!
        </h2>
        <a href={MAILING_LIST} class="no-underline">
          <button type="button" class="cta-button cta-button-lg font-bold">
            Join
          </button>
        </a>
      </div>
    </div>
  </main>
</Layout>

{
  slides.length > 1 && (
    <style
      is:inline
      set:html={`
      .home-slide {
        animation: home-crossfade ${TOTAL}s linear infinite both;
      }
      @keyframes home-crossfade {
        0%, 100% { opacity: 0 }
        ${pct(FADE)}, ${pct(CYCLE)} { opacity: 1 }
        ${pct(CYCLE + FADE)} { opacity: 0 }
      }
      @media (prefers-reduced-motion: reduce) {
        .home-slide { animation: none }
      }
    `}
    />
  )
}

<!-- the site header is fixed and light by default; invert it over this page -->
<style is:global>
  body:has(.home-inverted) {
    background: hsl(var(--color-accent-deep));
  }
  body:has(.home-inverted) #site-header {
    background: transparent;
    box-shadow: none;
  }
  body:has(.home-inverted) #site-header a {
    color: hsl(var(--color-fill));
  }
  body:has(.home-inverted) #site-header a:hover {
    color: hsl(var(--color-accent-inverted));
  }
  body:has(.home-inverted) #site-header svg {
    fill: hsl(var(--color-fill));
  }
  body:has(.home-inverted) #site-header a:hover svg {
    fill: hsl(var(--color-accent-inverted));
  }
  /* the open mobile menu is a light full-screen panel inside the header —
     the inversion above would render it white-on-white, so restore the
     default palette here */
  body:has(.home-inverted) #dropdown-content a {
    color: hsl(var(--color-accent));
  }
  body:has(.home-inverted) #dropdown-content a:hover {
    color: hsl(var(--color-accent-inverted));
  }
  body:has(.home-inverted) #dropdown-content a svg {
    fill: hsl(var(--color-accent-inverted));
  }
  body:has(.home-inverted) #dropdown-content a:hover svg {
    fill: hsl(var(--color-accent));
  }
</style>

<style>
  .home-inverted {
    background: hsl(var(--color-accent-deep));
  }
  .home-meta {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: hsl(var(--color-accent-bright));
  }
  .home-meta-hero {
    color: hsl(var(--color-accent-inverted));
  }
  .home-band {
    background: hsl(var(--color-fill));
  }
  .home-scrim {
    background: linear-gradient(
      to bottom,
      hsla(var(--color-accent-deep), 0.85) 0%,
      hsla(var(--color-accent-deep), 0.3) 35%,
      hsla(var(--color-accent-deep), 0.55) 78%,
      hsla(var(--color-accent-deep), 0.8) 100%
    );
  }
  /* Each slide runs the full cycle offset by its index, so the tail of one
     fade-out overlaps the head of the next fade-in. `both` fill keeps a slide
     hidden through its start delay. */
  .home-slide {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .home-slide {
      animation: none;
    }
    .home-slide:first-child {
      opacity: 1;
    }
  }
  .home-rule {
    border-color: hsla(var(--color-fill), 0.25);
  }
  .home-statement :global(a) {
    color: hsl(var(--color-accent-bright));
  }
</style>
